# Shared allocation env (copy into launches/<name>/.env)

# Solana RPC
RPC_URL=

# Indexer Postgres (read-only) for fund events (+ ownership scores for nash)
FUTARCHY_PG_URL=

# Launch authority key — env name comes from constants AUTHORITY_KEY_ENV
# e.g. RIPCARS_AUTHORITY_KEY= or LASO_AUTHORITY_KEY=
